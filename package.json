{
  "name": "vue-responsive-video-background-player",
  "version": "2.4.1",
  "description": "Play your own videos in background responsively",
  "main": "./dist/vue-responsive-video-background-player.umd.js",
  "unpkg": "./dist/vue-responsive-video-background-player.umd.js",
  "module": "./dist/vue-responsive-video-background-player.mjs",
  "exports": {
    ".": {
      "import": "./dist/vue-responsive-video-background-player.mjs",
      "require": "./dist/vue-responsive-video-background-player.umd.js"
    }
  },
  "private": false,
  "scripts": {
    "build:dist": "vite build --mode dist",
    "build:demo": "vite build --mode demo",
    "build": "npm run build:dist && npm run build:demo",
    "lint": "eslint --ext .js,.vue src demo/resources tests vite.config.mjs",
    "test": "vitest run",
    "prepack": "npm run build:dist"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avidofood/vue-responsive-video-background-player.git"
  },
  "keywords": [
    "vue 3",
    "vue3",
    "vue",
    "background",
    "video background player",
    "vue-responsive-videobg",
    "vue-video-player",
    "vue video player",
    "video player",
    "vue player",
    "vue video",
    "resolution switcher",
    "tesla"
  ],
  "author": {
    "name": "Philipp Mochine",
    "email": "support@avidofood.com",
    "url": "https://avidofood.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^8.57.1",
    "eslint-config-avidofood": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.3",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "release": {
    "branch": "master"
  },
  "publishConfig": {
    "tag": "latest"
  }
}
