{
  "name": "vue-responsive-video-background-player",
  "version": "2.5.1",
  "description": "Play your own videos in background responsively",
  "type": "commonjs",
  "main": "./dist/vue-responsive-video-background-player.umd.js",
  "unpkg": "./dist/vue-responsive-video-background-player.umd.js",
  "module": "./dist/vue-responsive-video-background-player.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/vue-responsive-video-background-player.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/vue-responsive-video-background-player.umd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "private": false,
  "scripts": {
    "build:dist": "vite build --mode dist",
    "build:demo": "vite build --mode demo",
    "build": "npm run build:dist && npm run build:demo",
    "lint": "eslint .",
    "test": "vitest run && npm run test:types",
    "test:types": "tsc -p tests/types",
    "prepack": "npm run build:dist"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avidofood/vue-responsive-video-background-player.git"
  },
  "bugs": {
    "url": "https://github.com/avidofood/vue-responsive-video-background-player/issues"
  },
  "homepage": "https://avidofood.github.io/vue-responsive-video-background-player/",
  "keywords": [
    "vue 3",
    "vue3",
    "vue",
    "background",
    "video background player",
    "vue-responsive-videobg",
    "vue-video-player",
    "vue video player",
    "video player",
    "vue player",
    "vue video",
    "resolution switcher",
    "tesla",
    "typescript",
    "ssr",
    "nuxt"
  ],
  "author": {
    "name": "Philipp Mochine",
    "email": "support@avidofood.com",
    "url": "https://avidofood.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-config-avidofood": "^4.0.0",
    "hls.js": "^1.7.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "release": {
    "branch": "master"
  },
  "publishConfig": {
    "tag": "latest"
  }
}
